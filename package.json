{
  "name": "mocked-server",
  "version": "8.6.0",
  "description": "Utility for mocking remote APIs servers for testing purposes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "mocked-server": {
    "testRunner": "mocha"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && npm run test:mocha && npm run test:jest && npm run test:types",
    "test:mocha": "cd test && mocha ./",
    "test:jest": "jest --config test/jest/jest.config.js",
    "test:types": "tsc --project test/types/tsconfig.json",
    "test:stryker": "stryker run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaclavObornik/mocked-server.git"
  },
  "keywords": [
    "mock",
    "api",
    "server",
    "testing",
    "tdd",
    "bdd"
  ],
  "author": "Václav Oborník",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/VaclavObornik/mocked-server/issues"
  },
  "homepage": "https://github.com/VaclavObornik/mocked-server#readme",
  "dependencies": {
    "@koa/router": "^15.7.0",
    "@types/koa": "^2.15.0",
    "debug": "^4.4.0",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "lodash": "^4.17.21",
    "pkg-up": "^3.1.0"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.6",
    "@types/debug": "^4.1.12",
    "@types/koa__router": "^12.0.5",
    "@types/lodash": "^4.17.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mocha": "^11.7.6",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
